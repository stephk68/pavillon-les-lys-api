# ====================================
# PAVILLON LES LYS API - CONFIGURATION
# ====================================

# Base de données PostgreSQL
DATABASE_URL="postgresql://pavillon_user:secure_password@localhost:5432/pavsdb?schema=public"

# JWT Configuration
JWT_SECRET=change_this_secret_in_production
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# Application
NODE_ENV=development
PORT=4000

# CORS Origins (URLs de production)
BACKOFFICE_URL=https://backoffice.pavillonleslys.com
FRONTOFFICE_URL=https://www.pavillonleslys.com

# Email Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=Pavillon Les Lys <your-email@gmail.com>

# Frontend URL (pour les liens dans les emails)
FRONTEND_URL=http://localhost:3001

# Sécurité
BCRYPT_ROUNDS=10

# Caution (montant par défaut en XOF)
CAUTION_AMOUNT=200000

# Docker Hub (pour deployment)
DOCKER_REGISTRY=kysaymeric
IMAGE_NAME=pavillon-les-lys
IMAGE_TAG=1.0
