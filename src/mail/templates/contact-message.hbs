<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f5f0e8;
        font-family: Georgia, "Times New Roman", serif;
      }
      .wrapper {
        background-color: #f5f0e8;
        padding: 40px 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #fdfaf5;
        border: 1px solid rgba(201, 161, 74, 0.15);
        border-radius: 0;
        overflow: hidden;
        border-top: 2px solid #b89140;
      }
      .header {
        text-align: center;
        padding: 40px 40px 20px;
        border-bottom: 1px solid rgba(201, 161, 74, 0.2);
      }
      .logo {
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 300;
        color: #b89140;
        font-size: 22px;
        text-decoration: none;
        letter-spacing: 0.25em;
        display: block;
      }
      .subtitle {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #a97c50;
        margin-top: 8px;
      }
      .content {
        padding: 35px 40px;
      }
      h1 {
        font-family: "Playfair Display", Georgia, serif;
        color: #000000;
        font-size: 26px;
        text-align: center;
        margin: 0 0 25px;
        font-weight: 300;
        letter-spacing: 0.04em;
        line-height: 1.2;
      }
      p {
        color: #000000;
        line-height: 1.7;
        font-size: 15px;
        margin: 0 0 16px;
      }
      .badge {
        text-align: center;
        margin: 10px 0 25px;
      }
      .badge span {
        display: inline-block;
        background: rgba(184, 145, 64, 0.08);
        color: #b89140;
        font-weight: 500;
        font-size: 14px;
        padding: 8px 20px;
        border-radius: 0;
        letter-spacing: 0.5px;
      }
      .recap-box {
        background: #f5f0e8;
        border-left: 4px solid #b89140;
        padding: 20px 24px;
        margin: 25px 0;
      }
      .recap-box p {
        margin: 0 0 8px;
        font-size: 14px;
      }
      .recap-box p:last-child {
        margin: 0;
      }
      .recap-box .label {
        color: #a97c50;
        font-weight: 500;
      }
      .message-box {
        margin-top: 25px;
      }
      .message-box h3 {
        font-family: "Playfair Display", Georgia, serif;
        color: #000000;
        font-size: 16px;
        margin: 0 0 12px;
        font-weight: 600;
        border-left: 4px solid #b89140;
        padding-left: 12px;
      }
      .message-content {
        background-color: #f5f0e8;
        border: 1px solid rgba(201, 161, 74, 0.15);
        border-radius: 0;
        padding: 18px 20px;
        font-size: 14px;
        color: #1a1610;
        line-height: 1.8;
        white-space: pre-wrap;
      }
      .divider {
        height: 1px;
        background-color: rgba(201, 161, 74, 0.2);
        margin: 30px 0;
      }
      .footer {
        text-align: center;
        padding: 25px 40px;
      }
      .footer p {
        font-size: 12px;
        color: #a97c50;
        margin: 0 0 6px;
        line-height: 1.5;
      }
      .footer .brand {
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 400;
        font-size: 13px;
        color: #b89140;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <div class="header">
          <a href="https://pavillonleslys.ci" class="logo">PAVILLON LES LYS</a>
          <div class="subtitle">Notification interne</div>
        </div>

        <div class="content">
          <h1>Nouveau message de contact</h1>

          <div class="badge">
            <span>Formulaire de contact</span>
          </div>

          <p>Un visiteur a soumis un message via le formulaire de contact du
            site.</p>

          <div class="recap-box">
            <p><span class="label">Nom :</span> {{firstName}} {{lastName}}</p>
            <p><span class="label">Email :</span> {{email}}</p>
            {{#if phone}}<p><span class="label">Téléphone :</span>
                {{phone}}</p>{{/if}}
            {{#if eventType}}<p><span class="label">Type d'événement :</span>
                {{eventType}}</p>{{/if}}
          </div>

          <div class="message-box">
            <h3>Message</h3>
            <div class="message-content">{{message}}</div>
          </div>
        </div>

        <div class="divider"></div>

        <div class="footer">
          <p class="brand">Pavillon Les Lys — Excellence & Convivialité</p>
          <p>Riviera Palmeraie, Abidjan — Côte d'Ivoire</p>
          <p><em>Ce message est automatique généré depuis le formulaire de
              contact.</em></p>
        </div>
      </div>
    </div>
  </body>
</html>