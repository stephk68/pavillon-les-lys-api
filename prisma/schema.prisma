// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  firstName    String
  lastName     String
  phone        String?
  role         Role          @default(CLIENT)
  isFirstLogin Boolean       @default(true)
  lastLoginAt  DateTime?
  reservations Reservation[]
  payments     Payment[]
  feedbacks    Feedback[]
  quotes       Quote[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdBy    String?
  updatedBy    String?
}

model Reservation {
  id                    String                  @id @default(uuid())
  user                  User                    @relation(fields: [userId], references: [id])
  userId                String
  eventType             EventType
  start                 DateTime
  end                   DateTime
  attendees             Int
  status                ReservationStatus       @default(PENDING)
  description           String?
  specialRequests       String?
  estimatedBudget       Decimal?                @db.Decimal(10, 2)
  quoteId               String?                 @unique
  quote                 Quote?                  @relation(fields: [quoteId], references: [id])
  payments              Payment[]
  checklist             ChecklistItem[]
  Feedback              Feedback[]
  reservationEquipments ReservationEquipment[] // Relation Many-to-Many avec InventoryItem
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  createdBy             String?
  updatedBy             String?
}

model Payment {
  id             String        @id @default(uuid())
  reservation    Reservation   @relation(fields: [reservationId], references: [id])
  reservationId  String
  quote          Quote?        @relation(fields: [quoteId], references: [id])
  quoteId        String?
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("XOF")
  type           PaymentType   // ACOMPTE | SOLDE | CAUTION
  status         PaymentStatus // PENDING | PAID | REFUNDED
  dueDate        DateTime?
  paidAt         DateTime?
  proofDocument  String?       // URL du justificatif de paiement
  // Champs pour gestion des cautions
  isRefundable   Boolean       @default(false)
  refundedAmount Decimal?      @db.Decimal(10, 2)
  refundedAt     DateTime?
  User           User?         @relation(fields: [userId], references: [id])
  userId         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      String?
  updatedBy      String?
}

model Quote {
  id            String       @id @default(uuid())
  number        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  reservation   Reservation?
  reservationId String?      // Optionnel - liaison post-conversion pour mode Funnel
  items         QuoteItem[]
  payments      Payment[]    // Paiements liés à ce devis
  totalHT       Decimal      @db.Decimal(10, 2)
  vatRate       Decimal      @default(0) @db.Decimal(5, 2) // TVA désactivée
  totalTTC      Decimal      @db.Decimal(10, 2)
  validUntil    DateTime
  status        QuoteStatus  @default(DRAFT)
  version       Int          @default(1) // Versioning du devis
  eventDetails  Json?        // {eventType, desiredStartDate, desiredEndDate, attendees} - pour devis standalone
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdBy     String?
  updatedBy     String?
}

model QuoteItem {
  id          String   @id @default(uuid())
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChecklistItem {
  id            String      @id @default(uuid())
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  reservationId String
  title         String
  description   String?                  // Description détaillée de la tâche
  completed     Boolean     @default(false)
  completedAt   DateTime?                // Date de complétion
  notes         String?                  // Notes lors de la complétion
  displayOrder  Int         @default(0)  // Ordre d'affichage
  assignedTo    String?
  dueAt         DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     String?
  updatedBy     String?

  @@index([reservationId])
}

model Feedback {
  id            String       @id @default(uuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  rating        Int          @default(5)
  comment       String?
  isRead        Boolean      @default(false)  // Feedback lu par l'admin
  response      String?                       // Réponse de l'admin
  respondedAt   DateTime?                     // Date de la réponse
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdBy     String?
  updatedBy     String?

  @@index([userId])
  @@index([isRead])
}

// ==================== INVENTORY MANAGEMENT ====================

model InventoryItem {
  id                    String                  @id @default(uuid())
  name                  String // Ex: "Chaise Napoléon", "Table Ronde 8 Places"
  description           String? // Description détaillée
  image                 String? // URL de l'image
  type                  InventoryItemType // INTERNAL (notre matériel) | EXTERNAL_PROVIDER (prestataire)
  category              String? // Ex: "Mobilier", "Décoration", "Sonorisation"
  providerName          String? // Nom du prestataire (si type = EXTERNAL_PROVIDER)
  providerContact       String? // Email/Téléphone du prestataire
  totalStock            Int                     @default(0) // Stock total (uniquement pour INTERNAL)
  availableStock        Int                     @default(0) // Stock disponible (calculé)
  status                InventoryItemStatus     @default(AVAILABLE) // AVAILABLE | MAINTENANCE | LOST
  unitPrice             Decimal?                @db.Decimal(10, 2) // Prix unitaire (optionnel)
  reservationEquipments ReservationEquipment[] // Relation Many-to-Many avec Reservation
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  createdBy             String?
  updatedBy             String?

  @@index([type, status]) // Index pour filtrer rapidement
  @@index([category])
}

model ReservationEquipment {
  id               String        @id @default(uuid())
  reservation      Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId    String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  inventoryItemId  String
  quantityReserved Int // Quantité sortie pour cet événement
  returnedQuantity Int           @default(0) // Quantité rendue (pour gérer la casse/perte)
  notes            String? // Notes sur l'état du matériel (dégâts, etc.)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([reservationId, inventoryItemId]) // Un item ne peut être lié qu'une fois par réservation
  @@index([reservationId])
  @@index([inventoryItemId])
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  EVENT_MANAGER
  CLIENT
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
}

enum PaymentType {
  ACOMPTE
  SOLDE
  CAUTION
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum EventType {
  MARIAGE
  ANNIVERSAIRE
  PROFESSIONNEL
  AUTRE
}

enum InventoryItemType {
  INTERNAL          // Matériel en interne (propriété de la salle)
  EXTERNAL_PROVIDER // Matériel fourni par un prestataire externe
}

enum InventoryItemStatus {
  AVAILABLE   // Disponible à la location
  MAINTENANCE // En maintenance/réparation
  LOST        // Perdu/Cassé (plus disponible)
}
