// Pavillon Les Lys — Prisma Schema
// Refactored: "Dossier Événement Unique" model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER ====================

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  firstName    String
  lastName     String
  phone        String?
  role         Role          @default(CLIENT)
  isFirstLogin Boolean       @default(true)
  lastLoginAt  DateTime?
  eventFolders EventFolder[]
  payments     Payment[]
  feedbacks    Feedback[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdBy    String?
  updatedBy    String?
}

// ==================== EVENT FOLDER (fusion Reservation + Quote) ====================

model EventFolder {
  id              String            @id @default(uuid())
  folderNumber    String            @unique @map("number") // EVT-2026-XXXX
  user            User              @relation(fields: [userId], references: [id])
  userId          String

  // Event info
  eventType       EventType
  start           DateTime
  end             DateTime
  attendees       Int
  description     String?
  specialRequests String?

  // Status — cycle de vie unique
  status          EventStatus       @default(PROSPECT)

  // Financial — items de devis intégrés
  items           EventFolderItem[]
  totalHT         Decimal           @default(0) @db.Decimal(10, 2)
  vatRate         Decimal           @default(0) @db.Decimal(5, 2)
  totalTTC        Decimal           @default(0) @db.Decimal(10, 2)
  validUntil      DateTime?

  // Versioning
  version         Int               @default(1)

  // Reminder flags
  reminderJ21SentAt DateTime?
  reminderJ14SentAt DateTime?
  contractSentAt    DateTime?

  // Relations
  payments        Payment[]
  checklist       ChecklistItem[]
  feedbacks       Feedback[]
  equipments      EventEquipment[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       String?
  updatedBy       String?

  @@index([userId])
  @@index([status])
  @@index([start, end])
}

model EventFolderItem {
  id            String      @id @default(uuid())
  eventFolder   EventFolder @relation(fields: [eventFolderId], references: [id], onDelete: Cascade)
  eventFolderId String
  description   String
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)
  totalPrice    Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([eventFolderId])
}

// ==================== PAYMENT ====================

model Payment {
  id             String        @id @default(uuid())
  eventFolder    EventFolder   @relation(fields: [eventFolderId], references: [id])
  eventFolderId  String
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("XOF")
  type           PaymentType   // ACOMPTE | SOLDE | CAUTION
  status         PaymentStatus @default(PENDING)
  dueDate        DateTime?
  paidAt         DateTime?
  proofDocument  String?
  isRefundable   Boolean       @default(false)
  refundedAmount Decimal?      @db.Decimal(10, 2)
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      String?
  updatedBy      String?

  @@index([eventFolderId])
  @@index([status])
}

// ==================== CHECKLIST ====================

model ChecklistItem {
  id            String      @id @default(uuid())
  eventFolder   EventFolder @relation(fields: [eventFolderId], references: [id], onDelete: Cascade)
  eventFolderId String
  title         String
  description   String?
  completed     Boolean     @default(false)
  completedAt   DateTime?
  notes         String?
  displayOrder  Int         @default(0)
  assignedTo    String?
  dueAt         DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdBy     String?
  updatedBy     String?

  @@index([eventFolderId])
}

// ==================== FEEDBACK ====================

model Feedback {
  id            String       @id @default(uuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  eventFolder   EventFolder? @relation(fields: [eventFolderId], references: [id])
  eventFolderId String?
  rating        Int          @default(5)
  comment       String?
  isRead        Boolean      @default(false)
  response      String?
  respondedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdBy     String?
  updatedBy     String?

  @@index([userId])
  @@index([isRead])
}

// ==================== INVENTORY ====================

model InventoryItem {
  id              String              @id @default(uuid())
  name            String
  description     String?
  image           String?
  type            InventoryItemType
  category        String?
  providerName    String?
  providerContact String?
  totalStock      Int                 @default(0)
  availableStock  Int                 @default(0)
  status          InventoryItemStatus @default(AVAILABLE)
  unitPrice       Decimal?            @db.Decimal(10, 2)
  eventEquipments EventEquipment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdBy       String?
  updatedBy       String?

  @@index([type, status])
  @@index([category])
}

model EventEquipment {
  id               String        @id @default(uuid())
  eventFolder      EventFolder   @relation(fields: [eventFolderId], references: [id], onDelete: Cascade)
  eventFolderId    String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  inventoryItemId  String
  quantityReserved Int
  returnedQuantity Int           @default(0)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([eventFolderId, inventoryItemId])
  @@index([eventFolderId])
  @@index([inventoryItemId])
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  EVENT_MANAGER
  CLIENT
}

enum EventStatus {
  PROSPECT   // Visite à faire, premier contact
  QUOTED     // Devis/contrat envoyé, en attente de signature
  BOOKED     // Acompte 50% reçu, contrat signé
  READY      // Solde & caution reçus, inventaire validé
  COMPLETED  // Événement terminé, inventaire post-event OK
  CANCELLED  // Annulé
}

enum PaymentType {
  ACOMPTE
  SOLDE
  CAUTION
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum EventType {
  MARIAGE
  ANNIVERSAIRE
  PROFESSIONNEL
  AUTRE
}

enum InventoryItemType {
  INTERNAL
  EXTERNAL_PROVIDER
}

enum InventoryItemStatus {
  AVAILABLE
  MAINTENANCE
  LOST
}
